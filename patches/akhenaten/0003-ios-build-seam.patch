+namespace {
+
+// G4 lifecycle: when the app moves to the background, pause the simulation
+// and write a dedicated lifecycle autosave so an active city can be resumed
+// after a foreground/terminate/relaunch cycle. Saves and configuration are
+// flushed; on foreground the sim stays paused until the player unpauses.
+void handle_ios_background() {
+    if (!city_has_loaded) {
+        return;
+    }
+    game.paused = true;
+    GamestateIO::write_savegame("lifecycle.svx");
+    game_features::save();
+}
+
+void handle_ios_foreground() {
+    // The simulation stays paused on return; audio/resources are revalidated
+    // by SDL's UIKit audio session handling on foreground.
+}
+
+} // namespace
+
+uint32_t platform_init_sdl_flags() {
+    return 0;
+}
+
+void platform_post_hint_init() {
+    // Landscape-first product view (the city and menus are wide layouts).
+    SDL_SetHint(SDL_HINT_ORIENTATIONS, "LandscapeLeft LandscapeRight");
+    // A pure-SDL UIKit app owns the whole screen; keep the home indicator
+    // out of the way in the landscape view.
+    SDL_SetHint(SDL_HINT_IOS_HIDE_HOME_INDICATOR, "1");
+    // ImGui and the SDL UI are mouse-event driven; synthesize mouse events
+    // from touches so the touch UI works on iPhone/iPad.
+    SDL_SetHint(SDL_HINT_TOUCH_MOUSE_EVENTS, "1");
+}
+
+void platform_setup_begin() {
+}
+
+void platform_run_init_callback() {
+}
+
+void platform_run_per_frame_callback() {
+}
+
+int platform_poll_event(CoreEvent* event) {
+    int result = SDL_PollEvent(reinterpret_cast<SDL_Event*>(event));
+    if (result) {
+        const SDL_Event* sdl_event = reinterpret_cast<const SDL_Event*>(event);
+        if (sdl_event->type == SDL_APP_WILLENTERBACKGROUND) {
+            handle_ios_background();
+        } else if (sdl_event->type == SDL_APP_DIDENTERFOREGROUND) {
+            handle_ios_foreground();
+        }
+    }
+    return result;
+}
