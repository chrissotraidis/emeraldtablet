     option(OPTION_ENABLE_INNOEXTRACT "Download innoextract helper for GOG/Inno Setup installers" ON)
 else()
     option(OPTION_ENABLE_INNOEXTRACT "Download innoextract helper for GOG/Inno Setup installers" OFF)
@@ -30,7 +34,7 @@ else()
     set(WIN_EMSCRIPTEN FALSE)
 endif()
 
-if((WIN32 OR UNIX) AND NOT ANDROID AND NOT EMSCRIPTEN AND NOT WIN_EMSCRIPTEN)
+if((WIN32 OR UNIX) AND NOT ANDROID AND NOT EMSCRIPTEN AND NOT WIN_EMSCRIPTEN AND NOT PLATFORM_IOS)
     option(OPTION_ENABLE_VIDEO_RECORDING "Build OpenH264 screen capture to MP4" ON)
