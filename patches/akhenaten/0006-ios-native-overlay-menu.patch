@@ -0,0 +1,18 @@
+#pragma once
+
+#include "platform.h"
+
+#if defined(GAME_PLATFORM_IOS)
+
+namespace ios_overlay {
+
+// Install the native "three-dot" control menu over the SDL window (pause,
+// speed, touch help). Safe to call more than once; the button is created once.
+void install_overlay();
+
+// Remove the overlay button (used on teardown).
+void remove_overlay();
+
+} // namespace ios_overlay
