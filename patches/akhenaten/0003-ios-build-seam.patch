 if(APPLE)
     if(NOT CMAKE_OSX_DEPLOYMENT_TARGET)
-        set(CMAKE_OSX_DEPLOYMENT_TARGET "10.15" CACHE STRING "Minimum OS X deployment version")
+        if(PLATFORM_IOS)
+            set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0" CACHE STRING "Minimum iOS deployment version")
+        else()
+            set(CMAKE_OSX_DEPLOYMENT_TARGET "10.15" CACHE STRING "Minimum OS X deployment version")
+        endif()
     endif()
     if(CMAKE_OSX_ARCHITECTURES)
         list(APPEND BUILD_ADDITIONAL_CMAKE_ARGS "-DCMAKE_OSX_ARCHITECTURES=${CMAKE_OSX_ARCHITECTURES}")
@@ -73,6 +98,22 @@ if(APPLE)
     if(CMAKE_OSX_SYSROOT)
         list(APPEND BUILD_ADDITIONAL_CMAKE_ARGS "-DCMAKE_OSX_SYSROOT=${CMAKE_OSX_SYSROOT}")
     endif()
+    list(APPEND BUILD_ADDITIONAL_CMAKE_ARGS "-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}")
+    if(PLATFORM_IOS)
+        # Dependency -P helpers configure their own builds; they must target the
+        # same iOS SDK/arch/deployment as the game. The helpers use the default
+        # single-config generator (they are written for it), which CMake 4.x
+        # supports for iOS directly. SDL2 needs IOS=TRUE and its Cocoa driver
+        # disabled so the UIKit video driver is selected.
+        list(APPEND BUILD_ADDITIONAL_CMAKE_ARGS "-DCMAKE_SYSTEM_NAME=iOS")
+        list(APPEND BUILD_ADDITIONAL_CMAKE_ARGS "-DIOS=TRUE")
+        list(APPEND BUILD_ADDITIONAL_CMAKE_ARGS "-DSDL_COCOA=OFF")
+        # CMake restricts find_* to the SDK root for cross builds; local
+        # dependency prefixes (freetype/harfbuzz/SDL2) must stay reachable.
+        list(APPEND BUILD_ADDITIONAL_CMAKE_ARGS "-DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=BOTH")
+        list(APPEND BUILD_ADDITIONAL_CMAKE_ARGS "-DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=BOTH")
+        list(APPEND BUILD_ADDITIONAL_CMAKE_ARGS "-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=BOTH")
+    endif()
     # cmake -P helpers take one -D string. A raw CMake list splits on ';' and
     # drops CMAKE_OSX_DEPLOYMENT_TARGET as a stray cache entry on the helper.
     string(REPLACE ";" "|" BUILD_ADDITIONAL_CMAKE_ARGS "${BUILD_ADDITIONAL_CMAKE_ARGS}")
