diff --git a/cmake/BuildSDL2.cmake b/cmake/BuildSDL2.cmake
index ce9f8eef5..57aac3f6f 100644
--- a/cmake/BuildSDL2.cmake
+++ b/cmake/BuildSDL2.cmake
@@ -13,6 +13,28 @@ file(MAKE_DIRECTORY ${SDL2_BUILD_DIR})
 file(MAKE_DIRECTORY ${SDL2_INSTALL_DIR})
 file(MAKE_DIRECTORY ${SDL2_INSTALL_DIR}/include)
 
+# iOS: give the Apple Pencil a distinct SDL touch device so the game can tell
+# stylus touches apart from fingers (G5 Pencil shell). SDL2 reports stylus
+# touches on the same direct-touch device as fingers, so tag them with a
+# dedicated touchId.
+if(SDL2_ADDITIONAL_CMAKE_ARGS MATCHES "iOS")
+    set(SDL2_UIKIT_VIEW "${SDL2_SOURCE_DIR}/src/video/uikit/SDL_uikitview.m")
+    file(READ "${SDL2_UIKIT_VIEW}" SDL2_UIKIT_VIEW_CONTENT)
+    string(REPLACE
+        "    SDL_TouchID directTouchId;\n    SDL_TouchID indirectTouchId;\n"
+        "    SDL_TouchID directTouchId;\n    SDL_TouchID indirectTouchId;\n    SDL_TouchID stylusTouchId;\n"
+        SDL2_UIKIT_VIEW_CONTENT "${SDL2_UIKIT_VIEW_CONTENT}")
+    string(REPLACE
+        "        directTouchId = 1;\n        indirectTouchId = 2;\n"
+        "        directTouchId = 1;\n        indirectTouchId = 2;\n        stylusTouchId = 0x4748454E43494C31ULL; /* 'PENCIL1' */\n"
+        SDL2_UIKIT_VIEW_CONTENT "${SDL2_UIKIT_VIEW_CONTENT}")
+    string(REPLACE
+        "SDL_TouchID touchId = [self touchIdForType:touchType];"
+        "SDL_TouchID touchId = (touch.type == UITouchTypeStylus) ? stylusTouchId : [self touchIdForType:touchType];"
+        SDL2_UIKIT_VIEW_CONTENT "${SDL2_UIKIT_VIEW_CONTENT}")
+    file(WRITE "${SDL2_UIKIT_VIEW}" "${SDL2_UIKIT_VIEW_CONTENT}")
+endif()
+
 set(SDL2_CMAKE_ARGS
     -DCMAKE_INSTALL_PREFIX=${SDL2_INSTALL_DIR}
     -DSDL_SHARED=OFF
@@ -236,4 +258,3 @@ else()
 endif()
 
 message(STATUS "SDL2 build completed successfully")
-
