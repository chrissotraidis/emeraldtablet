+void run_mod_import(NSURL *url) {
+    PickerState &st = picker();
+    st.state.store(State::copying);
+    const bool security_scoped = [url startAccessingSecurityScopedResource];
+
+    NSString *filename = url.lastPathComponent;
+    if (![filename.pathExtension.lowercaseString isEqualToString:@"sgx"]) {
+        mark_failed("Choose an Akhenaten mod with the .sgx extension.");
+        if (security_scoped) {
+            [url stopAccessingSecurityScopedResource];
+        }
+        return;
+    }
+
+    NSFileManager *fm = NSFileManager.defaultManager;
+    NSDictionary *attributes = [fm attributesOfItemAtPath:url.path error:nullptr];
+    if (!attributes || [attributes fileSize] == 0) {
+        mark_failed("The selected .sgx file is empty or unavailable.");
+        if (security_scoped) {
+            [url stopAccessingSecurityScopedResource];
+        }
+        return;
+    }
+
+    NSArray<NSURL *> *docs_urls = [fm URLsForDirectory:NSDocumentDirectory
+                                              inDomains:NSUserDomainMask];
+    if (docs_urls.count == 0) {
+        mark_failed("App Documents directory is unavailable.");
+        if (security_scoped) {
+            [url stopAccessingSecurityScopedResource];
+        }
+        return;
+    }
+
+    NSURL *mods_dir = [[docs_urls.firstObject URLByAppendingPathComponent:@"GameData"]
+        URLByAppendingPathComponent:@"mods"];
+    NSURL *destination = [mods_dir URLByAppendingPathComponent:filename];
+    if ([url.URLByStandardizingPath.path isEqualToString:destination.URLByStandardizingPath.path]) {
+        {
+            std::lock_guard<std::mutex> lock(st.mutex);
+            st.result_path = filename.UTF8String ?: "Imported mod";
+        }
+        st.state.store(State::done);
+        if (security_scoped) {
+            [url stopAccessingSecurityScopedResource];
+        }
+        return;
+    }
+
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        @autoreleasepool {
+            NSError *error = nil;
+            [fm createDirectoryAtURL:mods_dir
+          withIntermediateDirectories:YES
+                           attributes:nil
+                                error:&error];
+            NSURL *staging = [mods_dir URLByAppendingPathComponent:
+                [@"." stringByAppendingFormat:@"%@.importing", filename]];
+            [fm removeItemAtURL:staging error:nullptr];
+            if (!error && ![fm copyItemAtURL:url toURL:staging error:&error]) {
+                // error is populated by copyItemAtURL.
+            }
+            if (!error) {
+                if ([fm fileExistsAtPath:destination.path]) {
+                    [fm replaceItemAtURL:destination
+                           withItemAtURL:staging
+                          backupItemName:nil
+                                 options:0
+                        resultingItemURL:nullptr
+                                   error:&error];
+                } else {
+                    [fm moveItemAtURL:staging toURL:destination error:&error];
+                }
+            }
+
+            if (error) {
+                [fm removeItemAtURL:staging error:nullptr];
+                mark_failed("The selected mod could not be copied into Emerald Tablet.");
+            } else {
+                {
+                    std::lock_guard<std::mutex> lock(st.mutex);
+                    st.result_path = filename.UTF8String ?: "Imported mod";
+                }
+                st.state.store(State::done);
+            }
+            if (security_scoped) {
+                [url stopAccessingSecurityScopedResource];
+            }
+        }
+    });
+}
+
