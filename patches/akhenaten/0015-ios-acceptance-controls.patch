From 0000000000000000000000000000000000000015 Mon Sep 17 00:00:00 2001
Subject: [PATCH 0015] Make iPad configuration and build cancellation predictable

Purpose: Keep normal iOS launches in the game, expose the engine feature menu
from the native controls, default crisp scaling on, and make touch/Pencil build
cancellation leave the selected tool in one deliberate action.
Upstream status: downstream Apple product patch.
Affected platforms: iOS/iPadOS only; the shared cancel helper is inert unless
called by the iOS-specific paths.
Tests: clean ordered patch reconstruction, repository safety scan, iOS
Simulator/device builds and app audits, followed by physical iPad acceptance.

diff --git a/src/building/construction/build_planner.h b/src/building/construction/build_planner.h
--- a/src/building/construction/build_planner.h
+++ b/src/building/construction/build_planner.h
@@ -170,6 +170,7 @@
     void construction_update(tile2i tile);
     bool construction_active() const { return build_type != BUILDING_NONE; }
     void construction_cancel(bool release_sidebar = true);
+    void construction_cancel_all(bool release_sidebar = true);
     void construction_finalize();
 
     void add_building_tiles_from_list(int building_id, bool graphics_only);
diff --git a/src/building/construction/build_planner.cpp b/src/building/construction/build_planner.cpp
--- a/src/building/construction/build_planner.cpp
+++ b/src/building/construction/build_planner.cpp
@@ -283,8 +283,8 @@
     events::subscribe([this] (event_city_building_mode ev) {
         e_building_type btype = (e_building_type)ev.value;
 #if defined(GAME_PLATFORM_IOS)
-        if (touch_pencil_mode() && btype != BUILDING_NONE && btype == build_type) {
-            construction_cancel(false);
+        if (btype != BUILDING_NONE && btype == build_type) {
+            construction_cancel_all(false);
             return;
         }
 #endif
@@ -1005,6 +1005,13 @@
     update_orientations();
 }
 
+void build_planner::construction_cancel_all(bool release_sidebar) {
+    construction_cancel(release_sidebar);
+    if (construction_active()) {
+        construction_cancel(release_sidebar);
+    }
+}
+
 void build_planner::construction_update(tile2i tile) {
     end = tile;
     if (!end.valid()) {
