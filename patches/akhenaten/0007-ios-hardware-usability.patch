@@ -73,7 +77,81 @@ int touch_not_click(const touch_t * t) {
 }
 
 int touch_was_click(const touch_t * t) {
-    return (t->has_ended && !t->has_moved && (t->last_change_time - t->start_time) < CLICK_TIME);
+    return (!touch_is_navigation_only(t) && t->has_ended && !t->has_moved && !t->long_press_handled
+            && (t->last_change_time - t->start_time) < CLICK_TIME);
+}
+
+int touch_was_two_finger_tap(void) {
+    const touch_t *first = get_earliest_touch();
+    const touch_t *last = get_latest_touch();
+    if (!last->in_use || touch_is_navigation_only(first) || touch_is_navigation_only(last)
+        || last->start_time - first->start_time >= CLICK_TIME
+        || first->has_moved || last->has_moved
+        || first->long_press_handled || last->long_press_handled) {
+        return 0;
+    }
+    const time_millis now = time_get_millis();
+    const time_millis first_end = first->has_ended ? first->last_change_time : now;
+    const time_millis last_end = last->has_ended ? last->last_change_time : now;
+    return (first->has_ended || last->has_ended)
+        && first_end - first->start_time < CLICK_TIME
+        && last_end - last->start_time < CLICK_TIME;
+}
+
+int touch_poll_long_press(void) {
+    touch_t *t = const_cast<touch_t *>(get_earliest_touch());
+    const time_millis end_time = t->has_ended ? t->last_change_time : time_get_millis();
+    if (!t->in_use || touch_is_navigation_only(t) || t->long_press_handled
+        || abs(t->current_point.x - t->start_point.x) > 24
+        || abs(t->current_point.y - t->start_point.y) > 24
+        || end_time - t->start_time < LONG_PRESS_TIME) {
+        return 0;
+    }
+    t->long_press_handled = 1;
+    return 1;
+}
+
+int touch_is_navigation_only(const touch_t *t) {
+    return g_touch_data.pencil_mode && !t->is_stylus;
+}
+
+void touch_consume_current_gesture(void) {
+    auto &data = g_touch_data;
+    for (int i = 0; i < MAX_ACTIVE_TOUCHES; ++i) {
+        if (data.finger[i].in_use) {
+            data.finger[i].long_press_handled = 1;
+        }
+    }
+}
+
+touch_gesture touch_get_two_finger_gesture(void) {
+    auto &data = g_touch_data;
+    if (data.two_finger_gesture != TOUCH_GESTURE_UNDECIDED) {
+        return data.two_finger_gesture;
+    }
+    if (get_total_active_touches() != 2) {
+        return TOUCH_GESTURE_UNDECIDED;
+    }
+
+    const touch_t *first = get_earliest_touch();
+    const touch_t *last = get_latest_touch();
+    if (!first->has_moved || !last->has_moved) {
+        return TOUCH_GESTURE_UNDECIDED;
+    }
+
+    const int first_dx = first->current_point.x - first->start_point.x;
+    const int first_dy = first->current_point.y - first->start_point.y;
+    const int last_dx = last->current_point.x - last->start_point.x;
+    const int last_dy = last->current_point.y - last->start_point.y;
+    const int pan_delta = abs(first_dx + last_dx) + abs(first_dy + last_dy);
+    const int zoom_delta = abs(last_dx - first_dx) + abs(last_dy - first_dy);
+
+    if (zoom_delta >= TWO_FINGER_ZOOM_ACTIVATION && zoom_delta > pan_delta) {
+        data.two_finger_gesture = TOUCH_GESTURE_ZOOM;
+    } else if (pan_delta >= TWO_FINGER_PAN_ACTIVATION) {
+        data.two_finger_gesture = TOUCH_GESTURE_PAN;
+    }
+    return data.two_finger_gesture;
 }
 
