@@ -56,6 +60,23 @@ set(GAME akhenaten)
 project(${GAME} C CXX)
 message("C++ compiler is ${CMAKE_CXX_COMPILER_ID}" )
 
+# iOS detection. CMake's iOS toolchains set IOS; the sysroot is the fallback
+# when a generic Apple SDK is selected (e.g. -DCMAKE_OSX_SYSROOT=iphonesimulator).
+set(PLATFORM_IOS FALSE)
+if(IOS)
+    set(PLATFORM_IOS TRUE)
+elseif(APPLE AND CMAKE_OSX_SYSROOT MATCHES "iphoneos|iphonesimulator")
+    set(PLATFORM_IOS TRUE)
+endif()
+message(STATUS "PLATFORM_IOS: ${PLATFORM_IOS}")
+
+if(PLATFORM_IOS)
+    # Mobile MVP: no profiler capture, no helper binaries, no screen capture.
+    set(OPTION_ENABLE_TRACY OFF CACHE BOOL "Enable Tracy profiler support" FORCE)
+    set(OPTION_ENABLE_INNOEXTRACT OFF CACHE BOOL "Download innoextract helper for GOG/Inno Setup installers" FORCE)
+    set(OPTION_ENABLE_VIDEO_RECORDING OFF CACHE BOOL "Build OpenH264 screen capture to MP4" FORCE)
+endif()
+
 set(GAME_ARCH_64 TRUE)
 set(GAME_PROCESSOR_ARCH "x64")
 
