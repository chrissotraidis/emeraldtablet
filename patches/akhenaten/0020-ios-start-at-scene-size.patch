+
+bool active_scene_size(int &width, int &height) {
+    UIWindowScene *found = nil;
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+        if (![scene isKindOfClass:[UIWindowScene class]])
+            continue;
+        if (scene.activationState == UISceneActivationStateForegroundActive) {
+            found = (UIWindowScene *)scene;
+            break;
+        }
+        if (scene.activationState == UISceneActivationStateForegroundInactive && found == nil)
+            found = (UIWindowScene *)scene;
+    }
+    if (found == nil)
+        return false;
+    const CGSize size = found.coordinateSpace.bounds.size;
+    if (size.width < 1 || size.height < 1)
+        return false;
+    width = (int)size.width;
+    height = (int)size.height;
+    return true;
 }
 
 } // namespace ios_overlay
