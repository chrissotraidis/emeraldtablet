From 0000000000000000000000000000000000000019 Mon Sep 17 00:00:00 2001
Subject: [PATCH 0019] Re-fit the display scale when iPadOS resizes the window

Purpose: The iOS default display scale comes from the iPad's own screen
(about 133% on a 12.9-inch iPad). On an external display iPadOS resizes the
window (a TV is often 1280x720), but the resize path kept the old scale, so the
1024x768 interface grew larger than the window and menus such as Quit went off
screen. On iOS, each resize now re-applies the requested scale, which the
engine caps at what fits the new window.
Upstream status: downstream Apple product patch.
Affected platforms: iOS/iPadOS only (src/core/app.cpp, GAME_PLATFORM_IOS); scale_display
becomes public in src/platform/screen.h so the resize handler can call it.
Tests: clean ordered patch reconstruction; device check on an external display
still to do.

diff --git a/src/core/app.cpp b/src/core/app.cpp
--- a/src/core/app.cpp
+++ b/src/core/app.cpp
@@ -7,6 +7,7 @@
 #include "game/game_events.h"
 #include "game/game_events_history.h"
 #include "platform/screen.h"
+#include "platform/arguments.h"
 #include "graphics/screenshot.h"
 #include "core/log.h"
 #include "input/mouse.h"
@@ -133,7 +134,14 @@
         break;
     case SDL_WINDOWEVENT_SIZE_CHANGED:
         logs::info("Window resized to %d x %d", (int)event.data1, (int)event.data2);
+#if defined(GAME_PLATFORM_IOS)
+        // iPadOS resizes the window when it moves to an external display (a TV
+        // is often 1280x720). Re-fit the scale to the new size, so the 1024x768
+        // interface never ends up larger than the window.
+        g_platform_screen.scale_display(g_args.get_display_scale_percentage());
+#else
         g_platform_screen.resize(event.data1, event.data2, 1);
+#endif
         break;
     case SDL_WINDOWEVENT_RESIZED:
         logs::info("System resize to %d x %d", (int)event.data1, (int)event.data2);
diff --git a/src/platform/screen.h b/src/platform/screen.h
--- a/src/platform/screen.h
+++ b/src/platform/screen.h
@@ -34,12 +34,12 @@
     void* surface_format();
     vec2i get_max_resolution();
     void recreate_texture();
+    int scale_display(int display_scale_percentage);
 
 private:
     void* window = nullptr;
 
     void set_scale_percentage(int new_scale, int pixel_width, int pixel_height);
-    int scale_display(int display_scale_percentage);
 };
 
 extern platform_screen_t g_platform_screen;
\ No newline at end of file
