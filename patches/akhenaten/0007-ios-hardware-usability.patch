diff --git a/src/platform/platform_ios.cpp b/src/platform/platform_ios.cpp
index 48ad36769..938fc6964 100644
--- a/src/platform/platform_ios.cpp
+++ b/src/platform/platform_ios.cpp
@@ -13,6 +13,9 @@
 
 #include <SDL.h>
 
+#include <filesystem>
+#include <string>
+
 #include "content/vfs.h"
 
 namespace {
@@ -94,6 +97,26 @@ int platform_poll_event(CoreEvent* event) {
 }
 
 pcstr platform_request_initial_data_directory() {
+    // App updates may preserve Documents while iPadOS assigns a new container
+    // UUID. Never trust the absolute container path persisted by an older
+    // install; rediscover the conventional imported-data folder each launch.
+    static bstring512 data_directory;
+    char *pref = SDL_GetPrefPath("", "Akhenaten");
+    if (!pref) {
+        return nullptr;
+    }
+    const std::string pref_path(pref);
+    SDL_free(pref);
+    const std::string marker = "/Library/";
+    const size_t marker_pos = pref_path.find(marker);
+    if (marker_pos == std::string::npos) {
+        return nullptr;
+    }
+    data_directory.printf("%.*s/Documents/GameData", (int)marker_pos, pref_path.c_str());
+    const std::filesystem::path campaign = std::filesystem::path(data_directory.c_str()) / "campaign.txt";
+    if (std::filesystem::exists(campaign)) {
+        return data_directory.c_str();
+    }
     return nullptr;
 }
 
