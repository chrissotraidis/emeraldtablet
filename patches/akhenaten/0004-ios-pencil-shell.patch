diff --git a/src/platform/touch.cpp b/src/platform/touch.cpp
index 7ad5427ac..f16368b3a 100644
--- a/src/platform/touch.cpp
+++ b/src/platform/touch.cpp
@@ -5,6 +5,9 @@
 
 static SDL_FingerID touch_id[MAX_ACTIVE_TOUCHES];
 
+// Must match the SDL2 UIKit stylus touchId injected by BuildSDL2.cmake.
+static constexpr SDL_TouchID STYLUS_TOUCH_ID = 0x4748454E43494C31ULL;
+
 #ifdef __APPLE__
 static SDL_TouchID trackpad_id;
 #endif
@@ -37,7 +40,8 @@ void platform_touch_start(SDL_TouchFingerEvent* event) {
     if (event->touchId == 1)
         return;
 #endif
-    int index = touch_create(get_touch_coordinates(event->x, event->y), event->timestamp);
+    int is_stylus = (event->touchId == STYLUS_TOUCH_ID) ? 1 : 0;
+    int index = touch_create(get_touch_coordinates(event->x, event->y), event->timestamp, is_stylus);
     if (index != MAX_ACTIVE_TOUCHES)
         touch_id[index] = event->fingerId;
 }
