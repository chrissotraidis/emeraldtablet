+#if defined(GAME_PLATFORM_IOS)
+static bool handle_ios_hardware_text(SDL_KeyboardEvent* event) {
+    if (!g_keyboard.is_capturing() || !ios_overlay::hardware_keyboard_connected()
+        || (event->keysym.mod & (KMOD_CTRL | KMOD_ALT | KMOD_GUI))) {
+        return false;
+    }
+
+    const bool shifted = (event->keysym.mod & KMOD_SHIFT) != 0;
+    const SDL_Keycode key = event->keysym.sym;
+    char text[2] = {};
+    if (key >= SDLK_a && key <= SDLK_z) {
+        text[0] = (char)(shifted ? 'A' + (key - SDLK_a) : 'a' + (key - SDLK_a));
+    } else if (key >= SDLK_0 && key <= SDLK_9) {
+        static constexpr char shifted_digits[] = ")!@#$%^&*(";
+        text[0] = shifted ? shifted_digits[key - SDLK_0] : (char)key;
+    } else {
+        switch (key) {
+        case SDLK_SPACE: text[0] = ' '; break;
+        case SDLK_MINUS: text[0] = shifted ? '_' : '-'; break;
+        case SDLK_EQUALS: text[0] = shifted ? '+' : '='; break;
+        case SDLK_LEFTBRACKET: text[0] = shifted ? '{' : '['; break;
+        case SDLK_RIGHTBRACKET: text[0] = shifted ? '}' : ']'; break;
+        case SDLK_BACKSLASH: text[0] = shifted ? '|' : '\\'; break;
+        case SDLK_SEMICOLON: text[0] = shifted ? ':' : ';'; break;
+        case SDLK_QUOTE: text[0] = shifted ? '"' : '\''; break;
+        case SDLK_COMMA: text[0] = shifted ? '<' : ','; break;
+        case SDLK_PERIOD: text[0] = shifted ? '>' : '.'; break;
+        case SDLK_SLASH: text[0] = shifted ? '?' : '/'; break;
+        default: break;
+        }
+    }
+    if (!text[0]) {
+        return false;
+    }
+    g_keyboard.set_text(text);
+    return true;
+}
+#endif
