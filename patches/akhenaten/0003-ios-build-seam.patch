diff --git a/src/platform/platform_ios_picker.mm b/src/platform/platform_ios_picker.mm
new file mode 100644
index 000000000..0708abaf2
--- /dev/null
+++ b/src/platform/platform_ios_picker.mm
@@ -0,0 +1,292 @@
+#include "platform_ios_picker.h"
+
+#if defined(GAME_PLATFORM_IOS)
+
+#import <UIKit/UIKit.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+#include <SDL.h>
+#include <SDL_syswm.h>
+
+#include <atomic>
+#include <mutex>
+#include <string>
+
+namespace ios_picker {
+
+namespace {
+
+enum class State {
+    idle,
+    picking,
+    copying,
+    done,
+    failed,
+};
+
+struct PickerState {
+    std::atomic<State> state{State::idle};
+    std::mutex mutex;
+    std::string result_path;
+    std::string error;
+    std::atomic<int> last_progress{-1};
+};
+
+PickerState &picker() {
+    static PickerState state;
+    return state;
+}
+
+UIViewController *root_view_controller() {
+    SDL_Window *window = SDL_GetKeyboardFocus();
+    if (!window) {
+        return nullptr;
+    }
+    SDL_SysWMinfo info;
+    SDL_VERSION(&info.version);
+    if (!SDL_GetWindowWMInfo(window, &info)) {
+        return nullptr;
+    }
+    UIWindow *ui_window = (__bridge UIWindow *)info.info.uikit.window;
+    return ui_window.rootViewController;
+}
+
+std::string path_from_url(NSURL *url) {
+    const char *path = url.path.UTF8String;
+    return path ? std::string(path) : std::string();
+}
+
+// Find the Pharaoh game root: the picked folder itself, or the first subfolder
+// that contains campaign.txt (imports from a wrapper folder are common).
+std::string find_game_root(const std::string &dir) {
+    NSFileManager *fm = [NSFileManager defaultManager];
+    NSString *root = [NSString stringWithUTF8String:dir.c_str()];
+    if ([fm fileExistsAtPath:[root stringByAppendingPathComponent:@"campaign.txt"]]) {
+        return dir;
+    }
+    NSArray *entries = [fm contentsOfDirectoryAtPath:root error:nullptr];
+    for (NSString *entry in entries) {
+        NSString *candidate = [root stringByAppendingPathComponent:entry];
+        BOOL is_dir = NO;
+        if ([fm fileExistsAtPath:candidate isDirectory:&is_dir] && is_dir
+            && [fm fileExistsAtPath:[candidate stringByAppendingPathComponent:@"campaign.txt"]]) {
+            return std::string(candidate.UTF8String);
+        }
+    }
+    return {};
+}
+
+void copy_folder(NSString *source, NSString *dest) {
+    NSFileManager *fm = [NSFileManager defaultManager];
+    NSArray *entries = [fm contentsOfDirectoryAtPath:source error:nullptr];
+    [fm createDirectoryAtPath:dest withIntermediateDirectories:YES attributes:nil error:nullptr];
+    for (NSString *entry in entries) {
+        NSString *src = [source stringByAppendingPathComponent:entry];
+        NSString *dst = [dest stringByAppendingPathComponent:entry];
+        [fm copyItemAtPath:src toPath:dst error:nullptr];
+    }
+}
+
+// Mirror the macOS overlay union: the engine-owned Data files (fonts, packs,
+// default.map, mission maps) ship in the app bundle and must also be present
+// under the imported game-data Data/ for the engine's data check to pass.
+void merge_bundle_engine_data(NSString *staging) {
+    NSFileManager *fm = [NSFileManager defaultManager];
+    NSString *bundle = NSBundle.mainBundle.bundlePath;
+    NSString *engine_data = [bundle stringByAppendingPathComponent:@"Data"];
+    if (![fm fileExistsAtPath:engine_data]) {
+        return;
+    }
+    NSString *dest = [staging stringByAppendingPathComponent:@"Data"];
+    [fm createDirectoryAtPath:dest withIntermediateDirectories:YES attributes:nil error:nullptr];
+    NSArray *entries = [fm contentsOfDirectoryAtPath:engine_data error:nullptr];
+    for (NSString *entry in entries) {
+        NSString *src = [engine_data stringByAppendingPathComponent:entry];
+        NSString *dst = [dest stringByAppendingPathComponent:entry];
+        if (![fm fileExistsAtPath:dst]) {
+            [fm copyItemAtPath:src toPath:dst error:nullptr];
+        }
+    }
+}
+
+void promote_game_data(const std::string &staging, const std::string &docs) {
+    NSFileManager *fm = [NSFileManager defaultManager];
+    NSString *staging_path = [NSString stringWithUTF8String:staging.c_str()];
+    NSString *docs_path = [NSString stringWithUTF8String:docs.c_str()];
+    NSString *live = [docs_path stringByAppendingPathComponent:@"GameData"];
+
+    // Preserve Save/ from the live tree across a re-import.
+    NSString *old_save = [live stringByAppendingPathComponent:@"Save"];
+    NSString *new_save = [staging_path stringByAppendingPathComponent:@"Save"];
+    if ([fm fileExistsAtPath:old_save]) {
+        [fm createDirectoryAtPath:new_save withIntermediateDirectories:YES attributes:nil error:nullptr];
+        NSArray *items = [fm contentsOfDirectoryAtPath:old_save error:nullptr];
+        for (NSString *item in items) {
+            [fm copyItemAtPath:[old_save stringByAppendingPathComponent:item]
+                        toPath:[new_save stringByAppendingPathComponent:item]
+                         error:nullptr];
+        }
+    }
+
+    // Atomic promotion: never overwrite the live tree in place.
+    NSString *backup = [docs_path stringByAppendingPathComponent:@"GameData.old"];
+    [fm removeItemAtPath:backup error:nullptr];
+    if ([fm fileExistsAtPath:live]) {
+        [fm moveItemAtPath:live toPath:backup error:nullptr];
+    }
+    [fm moveItemAtPath:staging_path toPath:live error:nullptr];
+    [fm removeItemAtPath:backup error:nullptr];
+}
+
+} // namespace
+
+void mark_failed(const std::string &message) {
+    PickerState &st = picker();
+    {
+        std::lock_guard<std::mutex> lock(st.mutex);
+        st.error = message;
+    }
+    st.state.store(State::failed);
+}
+
+void run_import(NSURL *url) {
+    PickerState &st = picker();
+    st.state.store(State::copying);
+
+    std::string picked = path_from_url(url);
+    std::string root = find_game_root(picked);
+    if (root.empty()) {
+        {
+            std::lock_guard<std::mutex> lock(st.mutex);
+            st.error = "Selected folder has no campaign.txt (not a Pharaoh game install).";
+        }
+        st.state.store(State::failed);
+        return;
+    }
+
+    NSFileManager *fm = [NSFileManager defaultManager];
+    NSArray *docs_urls = [fm URLsForDirectory:NSDocumentDirectory inDomains:NSUserDomainMask];
+    if (docs_urls.count == 0) {
+        std::lock_guard<std::mutex> lock(st.mutex);
+        st.error = "App Documents directory is unavailable.";
+        st.state.store(State::failed);
+        return;
+    }
+    std::string docs = path_from_url(docs_urls.firstObject);
+    std::string staging = docs + "/GameData.staging";
+
+    [fm removeItemAtPath:[NSString stringWithUTF8String:staging.c_str()] error:nullptr];
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        @autoreleasepool {
+            NSString *src = [NSString stringWithUTF8String:root.c_str()];
+            NSString *dst = [NSString stringWithUTF8String:staging.c_str()];
+            copy_folder(src, dst);
+            merge_bundle_engine_data(dst);
+            promote_game_data(staging, docs);
+            {
+                std::lock_guard<std::mutex> lock(st.mutex);
+                st.result_path = docs + "/GameData";
+            }
+            st.state.store(State::done);
+        }
+    });
+}
+
+} // namespace ios_picker
+
+// Keep the delegate at global scope (Objective-C declarations cannot live in a
+// C++ namespace). It only forwards into the ios_picker namespace.
+@interface PickerDelegate : NSObject <UIDocumentPickerDelegate>
+@end
+
+@implementation PickerDelegate
+
++ (PickerDelegate *)sharedDelegate {
+    static PickerDelegate *delegate = nil;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        delegate = [[PickerDelegate alloc] init];
+    });
+    return delegate;
+}
+
+- (void)documentPicker:(UIDocumentPickerViewController *)controller
+    didPickDocumentsAtURLs:(NSArray<NSURL *> *)urls {
+    (void)controller;
+    if (urls.count > 0) {
+        NSURL *url = urls.firstObject;
+        [url startAccessingSecurityScopedResource];
+        ios_picker::run_import(url);
+    } else {
+        ios_picker::mark_failed("No folder was selected.");
+    }
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController *)controller {
+    (void)controller;
+    ios_picker::mark_failed("Folder selection was cancelled.");
+}
+
+@end
+
+namespace ios_picker {
+
+bool start_folder_pick() {
+    PickerState &st = picker();
+    State expected = State::idle;
+    if (!st.state.compare_exchange_strong(expected, State::picking)) {
+        return false;
+    }
+
+    dispatch_async(dispatch_get_main_queue(), ^{
+        UIViewController *vc = root_view_controller();
+        if (!vc) {
+            std::lock_guard<std::mutex> lock(st.mutex);
+            st.error = "Game window is not ready for the folder picker.";
+            st.state.store(State::failed);
+            return;
+        }
+        UIDocumentPickerViewController *picker_vc =
+            [[UIDocumentPickerViewController alloc] initForOpeningContentTypes:@[UTTypeFolder]];
+        picker_vc.allowsMultipleSelection = NO;
+        picker_vc.delegate = [PickerDelegate sharedDelegate];
+        [vc presentViewController:picker_vc animated:YES completion:nil];
+    });
+    return true;
+}
+
+bool is_active() {
+    State s = picker().state.load();
+    return s == State::picking || s == State::copying;
+}
+
+int progress() {
+    return picker().last_progress.load();
+}
+
+bool take_result(std::string &path_out, std::string &error_out) {
+    PickerState &st = picker();
+    State s = st.state.load();
+    if (s == State::done) {
+        {
+            std::lock_guard<std::mutex> lock(st.mutex);
+            path_out = st.result_path;
+            error_out.clear();
+        }
+        st.state.store(State::idle);
+        return true;
+    }
+    if (s == State::failed) {
+        {
+            std::lock_guard<std::mutex> lock(st.mutex);
+            error_out = st.error;
+        }
+        st.state.store(State::idle);
+        return false;
+    }
+    return false;
+}
+
+} // namespace ios_picker
